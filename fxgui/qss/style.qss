QProgressBar:horizontal {
    border: 1px solid @border;
    border-radius: @button_radius;
    text-align: center;
    padding: 1px;
    background: @surface_sunken;
    color: @text_on_accent_primary;
    height: 8px;
}

QProgressBar::chunk:horizontal {
    border-radius: 3px;
    background-color: qlineargradient(spread:reflect, x1:0, y1:0.5, x2:1, y2:0.5, stop:0 @accent_secondary, stop:1 @accent_primary);
}

QToolTip
{
    border: 1px solid @border_light;
    background-color: @surface_sunken;
    color: @text;
    padding: 4px 8px;
    border-radius: @button_radius;
}

QWidget
{
    /* Qt gives a widget made under a styled parent the app palette, not the
       parent's, so the text inks live here rather than in the palette. */
    color: @text;
    selection-background-color: @accent_primary;
    selection-color: @text_on_accent_primary;
    background-clip: border;
    border-image: none;
    /* This is Qt's focus rectangle, and it is the wrong tool for the job: it
       lands as a hard box around a widget's label, ignoring whatever shape
       the widget actually has. Measured on the dark theme, it drew on exactly
       two classes, a tab and a checkable group box, and on a tab it boxed the
       text inside the tab's own rounded lip. Both now carry a focus indicator
       drawn in their own language instead, so the rectangle is off. See
       KEYBOARD FOCUS at the end of the file. */
    outline: none;
}

QWidget:item:hover
{
    background-color: @accent_secondary;
    color: @text_on_accent_secondary;
}

QWidget:item:selected
{
    background-color: @accent_primary;
    color: @text_on_accent_primary;
}

QCheckBox
{
    spacing: 5px;
    outline: none;
    color: @text;
    margin-bottom: 2px;
    /* Reserved for the focus ring, which only recolours it. Declaring the
       border in both states is what stops the label shifting on focus. */
    border: 1px solid transparent;
    border-radius: @button_radius;
}

QCheckBox:disabled
{
    color: @text_disabled;
}
QCheckBox::indicator,
QGroupBox::indicator
{
    width: @indicator_size;
    height: @indicator_size;
}
QGroupBox::indicator
{
    margin-left: 2px;
}

QCheckBox::indicator:unchecked,
QCheckBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked,
QGroupBox::indicator:unchecked:hover
{
    image: url(~icons/checkbox_unchecked.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox[fxFocusVisible="true"]::indicator:unchecked:focus,
QCheckBox::indicator:unchecked:pressed,
QGroupBox[fxFocusVisible="true"]::indicator:unchecked:focus,
QGroupBox::indicator:unchecked:pressed
{
  border: none;
    image: url(~icons/checkbox_unchecked_focus.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox::indicator:checked,
QCheckBox::indicator:checked:hover,
QGroupBox::indicator:checked,
QGroupBox::indicator:checked:hover
{
    image: url(~icons/checkbox_checked.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox[fxFocusVisible="true"]::indicator:checked:focus,
QCheckBox::indicator:checked:pressed,
QGroupBox[fxFocusVisible="true"]::indicator:checked:focus,
QGroupBox::indicator:checked:pressed
{
  border: none;
    image: url(~icons/checkbox_checked_focus.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox::indicator:indeterminate,
QCheckBox::indicator:indeterminate:hover,
QCheckBox::indicator:indeterminate:pressed
QGroupBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate:hover,
QGroupBox::indicator:indeterminate:pressed
{
    image: url(~icons/checkbox_indeterminate.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox[fxFocusVisible="true"]::indicator:indeterminate:focus,
QGroupBox[fxFocusVisible="true"]::indicator:indeterminate:focus
{
    image: url(~icons/checkbox_indeterminate_focus.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled
{
    image: url(~icons/checkbox_checked_disabled.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled
{
    image: url(~icons/checkbox_unchecked_disabled.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton
{
    spacing: 5px;
    outline: none;
    color: @text;
    margin-bottom: 2px;
    /* Reserved for the focus ring, which only recolours it. Declaring the
       border in both states is what stops the label shifting on focus. */
    border: 1px solid transparent;
    border-radius: @button_radius;
}

QRadioButton:disabled
{
    color: @text_disabled;
}
QRadioButton::indicator
{
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton::indicator:unchecked,
QRadioButton::indicator:unchecked:hover
{
    image: url(~icons/radio_unchecked.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton[fxFocusVisible="true"]::indicator:unchecked:focus,
QRadioButton::indicator:unchecked:pressed
{
  border: none;
  outline: none;
    image: url(~icons/radio_unchecked_focus.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton::indicator:checked,
QRadioButton::indicator:checked:hover
{
  border: none;
  outline: none;
    image: url(~icons/radio_checked.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton[fxFocusVisible="true"]::indicator:checked:focus,
QRadioButton::indicator:checked:pressed
{
  border: none;
  outline: none;
    image: url(~icons/radio_checked_focus.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton::indicator:indeterminate,
QRadioButton::indicator:indeterminate:hover,
QRadioButton::indicator:indeterminate:pressed
{
    image: url(~icons/radio_indeterminate.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton::indicator:checked:disabled
{
    outline: none;
    image: url(~icons/radio_checked_disabled.svg);
    width: @indicator_size;
    height: @indicator_size;
}

QRadioButton::indicator:unchecked:disabled
{
    image: url(~icons/radio_unchecked_disabled.svg);
    width: @indicator_size;
    height: @indicator_size;
}


QMenuBar
{
    background-color: @surface_sunken;
    border-bottom: 1px solid @scrollbar_track;
}

/* One box in every state, so an item never changes shape: hover is the
   hover fill, and only an open menu wears the accent. `:enabled` lifts
   these over the `QWidget:item:selected` rule above. */
QMenuBar::item
{
    background: transparent;
    margin: 5px;
    padding: 5px;
    border-radius: @button_radius;
}

QMenuBar::item:selected:enabled,
QMenuBar::item:hover:enabled
{
    color: @text;
    background-color: @state_hover;
}

QMenuBar::item:pressed:enabled
{
    color: @text_on_accent_primary;
    background-color: @accent_primary;
}

QMenu
{
    border: 1px solid @border;
    border-radius: @button_radius;
    color: @text;
    /* margin: 2px; */
    background-color: @surface_sunken;
}

QMenu::icon
{
    /* Qt centres the icon on the whole box but draws the :checked frame
       inside the margins; near-even margins put both in one place. */
    margin-left: 12px;
    margin-right: 13px;
}

/* Qt draws a checkable action's icon instead of its check box, so the
   icon carries the checked state. */
QMenu::icon:checked
{
    background-color: @state_pressed;
    border: 1px solid @accent_primary;
    border-radius: @button_radius;
}

QMenu::item
{
    background-color: @surface_sunken;
    border-radius: @button_radius;
    padding: 5px 25px 5px 25px;
    border: 3px transparent;
}

QMenu::item:selected
{
    color: @text_on_accent_primary;
    background-color: @accent_primary;
}

QMenu::item:pressed
{
    color: @text_on_accent_secondary;
    background-color: @accent_secondary;
}

QMenu::separator {
    height: 1px;
    background-color: @border;
    margin-left: 10px;
    margin-right: 5px;
}

QMenu::indicator {
    width: 18px;
    height: 18px;
    /* Centres an 18 px box on the 16 px icon QMenu::icon places. */
    position: relative;
    left: 12px;
}

/* non-exclusive indicator = check box style indicator
   (see QActionGroup::setExclusive) */
QMenu::indicator:non-exclusive:unchecked {
    image: url(~icons/checkbox_unchecked.svg);
    width: 18px;
    height: 18px;
}

QMenu::indicator:non-exclusive:unchecked:selected {
    image: url(~icons/checkbox_unchecked_focus.svg);
    width: 18px;
    height: 18px;
}

QMenu::indicator:non-exclusive:checked {
    image: url(~icons/checkbox_checked.svg);
    width: 18px;
    height: 18px;
}

QMenu::indicator:non-exclusive:checked:selected {
    image: url(~icons/checkbox_checked_focus.svg);
    width: 18px;
    height: 18px;
}

/* exclusive indicator = radio button style indicator (see QActionGroup::setExclusive) */
QMenu::indicator:exclusive:unchecked {
    image: url(~icons/radio_unchecked.svg);
    width: 18px;
    height: 18px;
}

QMenu::indicator:exclusive:unchecked:selected {
    image: url(~icons/radio_unchecked_focus.svg);
    width: 18px;
    height: 18px;
}

QMenu::indicator:exclusive:checked {
    image: url(~icons/radio_checked.svg);
    width: 18px;
    height: 18px;
}

QMenu::indicator:exclusive:checked:selected {
    image: url(~icons/radio_checked_focus.svg);
    width: 18px;
    height: 18px;
}

QMenu::right-arrow {
    margin: 5px;
    width: 16px;
    height: 16px;
    image: ~icon(chevron_right, icon);
}

QMenu::right-arrow:selected {
    image: ~icon(chevron_right, icon_on_accent_primary);
}


QWidget:disabled
{
    color: @text_disabled;
}

QAbstractItemView
{
    alternate-background-color: @surface_alt;
    color: @text;
    background-color: @surface_sunken;
    border: 1px solid @border;
    border-radius: @button_radius;
    padding: 1px;
    /* Pixel scrolling, set at polish; a view that wants rows names
       ScrollPerItem in a rule of its own, by objectName. */
    qproperty-verticalScrollMode: ScrollPerPixel;
    qproperty-horizontalScrollMode: ScrollPerPixel;
}

/* Only remove focus border on widgets that don't need visible borders */
QMenuBar:focus
{
    border: none;
}

/* A `border: none` reset on focus used to cover QTabWidget, QCheckBox,
   QRadioButton and QSlider. It would now strip the ring off a checkbox and a
   radio button, and the other two never had a border for it to remove, so it
   is gone. See KEYBOARD FOCUS at the end of the file. */

QLineEdit
{
    background-color: @surface_sunken;
    padding: 4px 6px;
    border-style: solid;
    border: 1px solid @border;
    border-radius: @button_radius;
    color: @text;
}

/* The title sits in the margin above a whole card, never cut into its
   border; the margin is in em so it grows with the font. */
QGroupBox {
    border: 1px solid @border;
    border-radius: @card_radius;
    margin-top: 1.75em;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 2px;
}

/* A scroll bar is a pill on whatever it scrolls: no track, no arrows. The
   bar keeps one width, so the thumb widens inside it on hover and nothing
   beside it moves. */
QWidget#qt_scrollarea_hcontainer,
QWidget#qt_scrollarea_vcontainer,
QAbstractScrollArea::corner
{
    background: transparent;
    border: none;
}

QScrollBar:vertical,
QScrollBar:horizontal
{
    background: transparent;
    border: none;
    margin: 0px;
}

QScrollBar:vertical
{
    width: @thin_scroll;
}

QScrollBar:horizontal
{
    height: @thin_scroll;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal
{
    background: @scrollbar_thumb;
    border-radius: 2px;
}

QScrollBar::handle:vertical
{
    min-height: 24px;
    margin: 0px 2px;
}

QScrollBar::handle:horizontal
{
    min-width: 24px;
    margin: 2px 0px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed
{
    background: @scrollbar_thumb_hover;
    border-radius: @thin_scroll_radius;
    margin: 0px;
}

QScrollBar::add-line,
QScrollBar::sub-line
{
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page
{
    background: none;
}

/* A thin scroll area (fxstyle.mark_as_thin_scroll) sits on its card. */
[fxThinScroll="true"],
[fxThinScroll="true"] > QWidget#qt_scrollarea_viewport
{
    background: transparent;
    border: none;
}

QSizeGrip {
    background: transparent;
    /* image: url(~icons/sizegrip.svg); */
    width: 0;
    height: 0;
}


QMainWindow::separator
{
    background-color: @surface;
    color: @text;
    padding-left: 4px;
    spacing: 2px;
    border: 1px dashed @border;
}

QMainWindow::separator:hover
{

    background-color: @separator;
    color: @text;
    padding-left: 4px;
    border: 1px solid @border;
    spacing: 2px;
}


QFrame
{
    border-radius: @button_radius;
    /* border: 1px solid @border_strong; */
}

QFrame[frameShape="0"]
{
    border-radius: @button_radius;
    border: 1px transparent @border_strong;
}

/* HLine and VLine: one flat pixel, not Qt's two-tone bevel, which reads as
   a groove on a dark panel. */
QFrame[frameShape="4"]
{
    border: none;
    background-color: @border;
    min-height: 1px;
    max-height: 1px;
}

QFrame[frameShape="5"]
{
    border: none;
    background-color: @border;
    min-width: 1px;
    max-width: 1px;
}

QStackedWidget
{
    border: 1px transparent;
}

/* Text widgets - must come AFTER QFrame to override border-radius */
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: @surface_sunken;
    color: @text;
    border: 1px solid @border;
    border-radius: @button_radius;
}

QTextEdit#fxOutputLogArea {
    font-family: @font_mono;
    font-size: 9pt;
}

QToolBar {
    border: 1px transparent @border_strong;
    background: 1px solid @surface;
    font-weight: bold;
    border-bottom: 1px solid @border;
}

QToolBar::handle:horizontal {
    image: url(~icons/horizontal_move_toolbar.svg);
    width: 18px;
    height: 18px;
}
QToolBar::handle:vertical {
    image: url(~icons/vertical_move_toolbar.svg);
    width: 18px;
    height: 18px;
}
QToolBar::separator:horizontal {
    image: url(~icons/horizontal_separator_toolbar.svg);
    width: 18px;
    height: 18px;
}
QToolBar::separator:vertical {
    image: url(~icons/vertical_separator_toolbar.svg);
    width: 18px;
    height: 18px;
}

QPushButton
{
    color: @text;
    background-color: @surface;
    border-width: 1px;
    border-color: @border_light;
    border-style: solid;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: @button_radius;
    outline: none;
}

QPushButton:disabled
{
    background-color: @surface;
    border-width: 1px;
    border-color: @border;
    border-style: solid;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    /*border-radius: 2px;*/
    color: @border_strong;
}

QPushButton:focus {
    border: 1px solid @border_light;
}

QComboBox
{
    selection-background-color: @accent_primary;
    background-color: @surface_sunken;
    border-style: solid;
    border: 1px solid @border;
    border-radius: @button_radius;
    padding: 4px 6px;
    min-width: 75px;
}

QPushButton:checked{
    background-color: @state_pressed;
    border-color: @grid;
}

QComboBox:hover,
QAbstractSpinBox:hover,
QLineEdit:hover,
QTextEdit:hover,
QTextBrowser:hover,
QPlainTextEdit:hover,
QAbstractView:hover,
QTreeView:hover,
QTreeWidget:hover,
QListView:hover,
QTableView:hover,
QTableWidget:hover
{
    border: 1px solid @accent_primary;
    color: @text;
}

QPushButton:hover
{
    border: 1px solid @accent_primary;
    background-color: @state_hover;
    color: @text;
}


QComboBox:on
{
    /* background-color: #626873; */
    padding-top: 3px;
    padding-left: 4px;
    /* selection-background-color: #4a4a4a; */
}

QComboBox QAbstractItemView
{
    background-color: @surface_sunken;
    border: 1px solid @border_strong;
    selection-background-color: @accent_primary;
    padding: 0px;
    margin: 0px;
    outline: none;
}

QComboBox QFrame
{
    background-color: @surface_sunken;
    border: 1px solid @border_strong;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
}

QComboBox QAbstractItemView::item
{
    background-color: @surface_sunken;
    padding: 4px;
    margin: 0px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:selected
{
    background-color: @accent_primary;
}

/* Every arrow is the accordion's chevron in @icon: here, on a spin box,
   a header's sort mark, a menu, a tab bar's scroll buttons, a tool button
   and a push button with a menu. */
QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: none;
}

QComboBox::down-arrow
{
    image: ~icon(expand_more, icon);
    width: 16px;
    height: 16px;
}

QComboBox::down-arrow:disabled
{
    image: ~icon(expand_more, text_disabled);
}

QPushButton:pressed
{
    background-color: @state_pressed;
}

/* FXPrimaryButton, or any QPushButton with fxRole="primary". The fills are
   the accents shifted until their text reads at 4.5:1 (see fxstyle). */
QPushButton[fxRole="primary"]
{
    color: @text_on_accent_primary;
    background-color: @primary_button;
    border-color: @primary_button;
}

QPushButton[fxRole="primary"]:hover
{
    color: @text_on_accent_secondary;
    background-color: @primary_button_hover;
    border-color: @primary_button_hover;
}

/* After :hover, so a hovered press draws the text its fill was tuned for. */
QPushButton[fxRole="primary"]:pressed
{
    color: @text_on_accent_primary;
    background-color: @primary_button_pressed;
    border-color: @primary_button_pressed;
}

QPushButton[fxRole="primary"]:disabled
{
    color: @text_disabled;
    background-color: @surface_alt;
    border-color: @border;
}

QAbstractSpinBox {
    /* One more on top than below brings it to a line edit's height. */
    padding-top: 3px;
    padding-bottom: 2px;
    border: 1px solid @border;
    background-color: @surface_sunken;
    color: @text;
    border-radius: @button_radius;
    min-width: 75px;
}

QAbstractSpinBox:up-button
{
    background-color: transparent;
    subcontrol-origin: border;
    subcontrol-position: center right;
}

QAbstractSpinBox:down-button
{
    background-color: transparent;
    subcontrol-origin: border;
    subcontrol-position: center left;
}

QAbstractSpinBox::up-arrow,
QAbstractSpinBox::down-arrow
{
    width: 16px;
    height: 16px;
}

QAbstractSpinBox::up-arrow
{
    image: ~icon(expand_less, icon);
}

QAbstractSpinBox::down-arrow
{
    image: ~icon(expand_more, icon);
}

/* :off is an arrow at its end of the range. */
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off
{
    image: ~icon(expand_less, text_disabled);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off
{
    image: ~icon(expand_more, text_disabled);
}

QLabel
{
    border: 0px solid;
}

QTabWidget{
    border: 1px transparent;
}

QTabWidget::pane {
    top:-1px;
    border: 1px solid @border_light;
    border-radius: @button_radius;
    padding: 3px;
}

QTabBar
{
    qproperty-drawBase: 0;
    left: 5px; /* Move to the right by 5px */
    background-color: @surface_sunken;
    border-top-left-radius: @button_radius;
    border-top-right-radius: @button_radius;
    margin-top: 3px;
}

QTabBar:focus
{
    border: 0px transparent;
}

QTabBar QToolButton {
    background-color: @surface_sunken;
    border: 1px solid @border_light;
    border-bottom: 1px solid @border_light;
    border-radius: @button_radius;
    margin: 0px;
    margin-top: 3px;
    padding: 4px 6px;
}

QTabBar QToolButton:hover {
    background-color: @state_pressed;
}

QTabBar QToolButton:pressed {
    background-color: @state_pressed;
}

QTabBar QToolButton::right-arrow,
QTabBar QToolButton::left-arrow {
    width: 16px;
    height: 16px;
}

QTabBar QToolButton::right-arrow {
    image: ~icon(chevron_right, icon);
}

QTabBar QToolButton::left-arrow {
    image: ~icon(chevron_left, icon);
}

QTabBar QToolButton::right-arrow:disabled {
    image: ~icon(chevron_right, text_disabled);
}

QTabBar QToolButton::left-arrow:disabled {
    image: ~icon(chevron_left, text_disabled);
}

QTabBar::close-button  {
    image: url(~icons/close.svg);
    background: transparent;
}

QTabBar::close-button:hover
{
    image: url(~icons/close_hover.svg);
    background: transparent;
}

QTabBar::close-button:pressed {
    image: url(~icons/close_pressed.svg);
    background: transparent;
}

QTabBar::close-button:!selected {
    border: 1px transparent;
    border-bottom: 1px transparent;
    border-top-left-radius: @button_radius;
    border-top-right-radius: @button_radius;
    margin-top: 3px;
}

/* TOP TABS */
QTabBar::tab:top {
    color: @text;
    border: 1px solid @border_light;
    border-bottom: 1px transparent;
    background-color: @surface;
    padding: 5px 20px;
    border-top-left-radius: @button_radius;
    border-top-right-radius: @button_radius;
    min-width: 75px;
}

QTabBar::tab:top:selected {
    color: @text;
    background-color: @surface;
    border-bottom: 1px solid @surface;
}

QTabBar::tab:top:!selected {
    color: @text_muted;
    background-color: @surface_sunken;
    border: 1px transparent @border_light;
    border-bottom: 1px solid @border_light;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-top: 3px;
}

QTabBar::tab:top:!selected:hover {
    color: @text;
    background-color: @state_pressed;
}

QTabBar::tab:top:first:!selected {
    border-top-left-radius: @button_radius;
}

QTabBar::tab:top:last:!selected {
    border-top-right-radius: @button_radius;
}

/* LEFT TABS */
QTabBar::tab:left {
    color: @text;
    border: 1px solid @border_light;
    border-right: 1px transparent;
    background-color: @surface;
    padding: 5px 20px;
    border-top-left-radius: @button_radius;
    border-bottom-left-radius: @button_radius;
    min-width: 75px;
}

QTabBar::tab:left:selected {
    color: @text;
    background-color: @surface;
    border-right: 1px solid @surface;
}

QTabBar::tab:left:!selected {
    color: @text_muted;
    background-color: @surface_sunken;
    border: 1px transparent @border_light;
    border-right: 1px solid @border_light;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    margin-left: 3px;
}

QTabBar::tab:left:!selected:hover {
    color: @text;
    background-color: @state_pressed;
}

QTabBar::tab:left:first:!selected {
    border-top-left-radius: @button_radius;
}

QTabBar::tab:left:last:!selected {
    border-bottom-left-radius: @button_radius;
}

/* BOTTOM TABS */
QTabBar::tab:bottom {
    color: @text;
    border: 1px solid @border_light;
    border-top: 1px transparent;
    background-color: @surface;
    padding: 5px 20px;
    border-bottom-left-radius: @button_radius;
    border-bottom-right-radius: @button_radius;
    min-width: 75px;
}

QTabBar::tab:bottom:selected {
    color: @text;
    background-color: @surface;
    border-top: 1px solid @surface;
}

QTabBar::tab:bottom:!selected {
    color: @text_muted;
    background-color: @surface_sunken;
    border: 1px transparent @border_light;
    border-top: 1px solid @border_light;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    margin-bottom: 3px;
}

QTabBar::tab:bottom:!selected:hover {
    color: @text;
    background-color: @state_pressed;
}

QTabBar::tab:bottom:first:!selected {
    border-bottom-left-radius: @button_radius;
}

QTabBar::tab:bottom:last:!selected {
    border-bottom-right-radius: @button_radius;
}

/* RIGHT TABS */
QTabBar::tab:right {
    color: @text;
    border: 1px solid @border_light;
    border-left: 1px transparent;
    background-color: @surface;
    padding: 5px 20px;
    border-top-right-radius: @button_radius;
    border-bottom-right-radius: @button_radius;
    min-width: 75px;
}

QTabBar::tab:right:selected {
    color: @text;
    background-color: @surface;
    border-left: 1px solid @surface;
}

QTabBar::tab:right:!selected {
    color: @text_muted;
    background-color: @surface_sunken;
    border: 1px transparent @border_light;
    border-left: 1px solid @border_light;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    margin-right: 3px;
}

QTabBar::tab:right:!selected:hover {
    color: @text;
    background-color: @state_pressed;
}

QTabBar::tab:right:first:!selected {
    border-top-right-radius: @button_radius;
}

QTabBar::tab:right:last:!selected {
    border-bottom-right-radius: @button_radius;
}


QDockWidget {
    border: 1px solid @state_hover;
    border-radius: @button_radius;
    titlebar-close-icon: url(~icons/close.svg);
    titlebar-normal-icon: url(~icons/undock.svg);
}

QDockWidget::title {
    text-align: left;
    background-color: @surface_sunken;
    border: 1px solid @state_hover;
    border-top-left-radius: @button_radius;
    border-top-right-radius: @button_radius;
    padding: 6px;
    padding-right: 60px;
}

QDockWidget::close-button {
    border: 1px solid transparent;
    border-radius: @button_radius;
    background: transparent;
    subcontrol-origin: margin;
    subcontrol-position: top right;
    position: absolute;
    top: 4px;
    right: 4px;
    width: 20px;
    height: 20px;
}

QDockWidget::float-button {
    border: 1px solid transparent;
    border-radius: @button_radius;
    background: transparent;
    subcontrol-origin: margin;
    subcontrol-position: top right;
    position: absolute;
    top: 4px;
    right: 28px;
    width: 20px;
    height: 20px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: @state_pressed;
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    padding: 1px -1px -1px 1px;
    background: @state_pressed;
}


/* Item views inherit from QAbstractItemView above */
/* Use show-decoration-selected: 1 so the entire row gets consistent
   highlighting. Branch uses @surface_sunken to match item background
   (Qt ignores 'transparent' for branch selection/hover painting). */
QTreeView::branch {
    background: @surface_sunken;
}

/* Override branch background to stay neutral during selection/hover
   since the delegate handles item painting, not the branch area */
QTreeView::branch:selected,
QTreeView::branch:!selected:hover {
    background: @surface_sunken;
}

/* No branch lines; a parent shows the accordion's chevron. */
QTreeView::branch:has-children:closed {
    image: ~icon(chevron_right, icon);
}

QTreeView::branch:has-children:open {
    image: ~icon(expand_more, icon);
}

QListView,
QTreeView {
    show-decoration-selected: 1;
}

QListView::item,
QTreeView::item {
    padding: 4px 8px;
    min-height: 18px;
    max-height: 18px;
}

/* A radius makes the sheet draw the whole cell, which hides an item's own
   BackgroundRole; only the highlighted states carry one. */
QListView::item:hover,
QTreeView::item:hover,
QListView::item:selected,
QTreeView::item:selected {
    border-radius: @button_radius;
}

QListView::item:!selected:hover,
QTreeView::item:!selected:hover {
    background: @accent_secondary;
    outline: 0;
    color: @text_on_accent_secondary;
}

QListView::item:selected:hover,
QTreeView::item:selected:hover {
    background: @accent_primary;
    color: @text_on_accent_primary;
}

/* A slider is a 4 px pill, its filled span the accent, and a round handle:
   surface fill and accent edge, a thicker edge on hover, an accent fill while
   pressed. The handle overhangs the groove by a negative margin, and the
   slider is as thick as an indicator so the handle is never clipped. A
   handle's width excludes its border, so every state keeps a 16 px box and
   the handle never shifts along the groove. */
QSlider:horizontal {
    min-height: @indicator_size;
}

QSlider:vertical {
    min-width: @indicator_size;
}

QSlider::groove:horizontal,
QSlider::sub-page:horizontal {
    border: none;
    height: 4px;
    margin: 0;
    background: @surface_sunken;
    border-radius: 2px;
}

QSlider::groove:vertical,
QSlider::add-page:vertical {
    border: none;
    width: 4px;
    margin: 0;
    background: @surface_sunken;
    border-radius: 2px;
}

/* A vertical slider fills from the bottom, which is its add-page. */
QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background: @accent_primary;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background: @surface;
    border: 2px solid @accent_primary;
    width: 12px;
    height: 12px;
    border-radius: 8px;
}

QSlider::handle:horizontal {
    margin: -6px 0;
}

QSlider::handle:vertical {
    margin: 0 -6px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    border-width: 4px;
    width: 8px;
    height: 8px;
}

QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: @accent_primary;
}

QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: @surface;
    border-color: @border;
}

QSlider::sub-page:horizontal:disabled,
QSlider::add-page:vertical:disabled {
    background: @border_strong;
}

/* Plain QToolButtons (toolbars, icon buttons) stay flat: transparent
   until hovered. Split buttons (MenuButtonPopup) instead read like
   QPushButtons — see the popupMode="1" overrides below. */
QToolButton {
    background-color: transparent;
    /* Reserved for the hover and focus edges, so neither moves the icon. */
    border: 1px solid transparent;
    border-radius: @button_radius;
    margin: 3px;
    padding: 2px;
}

QToolButton[popupMode="1"] { /* MenuButtonPopup: QPushButton look */
    color: @text;
    background-color: @surface;
    border: 1px solid @border_light;
    border-radius: @button_radius;
    margin: 0px;
    padding: 5px 10px;
    padding-right: 22px; /* room for the menu-button section */
    outline: none;
}

QToolButton[popupMode="1"]:disabled {
    background-color: @surface;
    border: 1px solid @border;
    color: @border_strong;
}

QToolButton[popupMode="2"] { /* only for InstantPopup */
 padding-right: 12px; /* make way for the indicator */
 border: 1px transparent @border_light;
}

/* The secondary accent, as a hovered item row: the icon's hover colour is
   made for it, so no theme can draw the icon in the background's own. */
QToolButton:hover,
QToolButton::menu-button:hover {
    background-color: @accent_secondary;
    border: 1px solid @accent_primary;
    color: @text_on_accent_secondary;
}

/* A split button hovers as a QPushButton, its arrow part included. */
QToolButton[popupMode="1"]:hover {
    border: 1px solid @accent_primary;
    background-color: @state_hover;
    color: @text;
}

/* The button's own fill shows through, and its border stays whole. */
QToolButton[popupMode="1"]::menu-button:hover {
    background-color: transparent;
}

QToolButton:checked,
QToolButton:pressed,
        QToolButton::menu-button:pressed {
    background-color: @state_pressed;
    border: 1px solid @accent_primary;
}

/* the subcontrol below is used only in the InstantPopup or DelayedPopup mode */
QToolButton::menu-indicator {
    image: ~icon(expand_more, icon);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 2px;
}

/* the subcontrols below are used only in the MenuButtonPopup mode */
QToolButton::menu-button {
    border: none;
    border-left: 1px solid @border_light;
    border-top-right-radius: @button_radius;
    border-bottom-right-radius: @button_radius;
    width: 12px;
    outline: none;
}

QToolButton::menu-button:hover {
    border: none;
    border-left: 1px solid @accent_primary;
}

QToolButton::menu-arrow {
    image: ~icon(expand_more, icon);
    width: 12px;
    height: 12px;
}

QToolButton::menu-arrow:disabled {
    image: ~icon(expand_more, text_disabled);
}


QPushButton::menu-indicator  {
    image: ~icon(expand_more, icon);
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 12px;
    height: 12px;
}

QPushButton::menu-indicator:disabled {
    image: ~icon(expand_more, text_disabled);
}


QTableView
{
    gridline-color: @grid;
}


QTableView::item:pressed,
QListView::item:pressed,
QTreeView::item:pressed  {
    border-color: @accent_primary;
    background: @accent_primary;
    color: @text_on_accent_primary;
}

QTableView::item:selected:active,
QTreeView::item:selected:active,
QListView::item:selected:active  {
    border-color: @accent_secondary;
    background: @accent_primary;
    color: @text_on_accent_primary;
}


QHeaderView
{
    border: 1px transparent;
    border-radius: @button_radius;
    margin: 0px;
    padding: 0px;
}

QHeaderView::section  {
    background-color: @border;
    /*color: silver;*/
    padding: 4px;
    border: 1px solid @grid;
    border-radius: 0px;
    text-align: center;
}

QHeaderView::section::vertical::first,
QHeaderView::section::vertical::only-one
{
    border-top: 1px solid @grid;
}

QHeaderView::section::vertical
{
    border-top: transparent;
}

QHeaderView::section::horizontal::first,
QHeaderView::section::horizontal::only-one
{
    border-left: 1px solid @grid;
}

QHeaderView::section::horizontal
{
    border-left: transparent;
}

QHeaderView::section:checked
{
    color: @text;
    background-color: @scrollbar_thumb;
}

/* style the sort indicator */
QHeaderView::down-arrow,
QHeaderView::up-arrow {
    width: 12px;
    height: 12px;
    margin-right: 4px;
}

QHeaderView::down-arrow {
    image: ~icon(expand_more, icon);
}

QHeaderView::up-arrow {
    image: ~icon(expand_less, icon);
}

QTableCornerButton::section {
    background-color: @border;
    border: 1px solid @border;
    border-radius: @button_radius;
}


QToolBox  {
    padding: 3px;
    border: 1px transparent;
}

QToolBox::tab {
    color: @text_muted;
    background-color: @surface_sunken;
    border: 1px solid @border_light;
    border-bottom: 1px transparent @surface;
    border-top-left-radius: @button_radius;
    border-top-right-radius: @button_radius;
}

QToolBox::tab:selected { /* Bold selected tabs */
    font: bold;
    background-color: @surface;
    border-color: @accent_primary;
}


QStatusBar {
    background-color: @surface_sunken;
    border-top: 1px solid @scrollbar_track;
}

QStatusBar::item {
    background: transparent;
    border: 1px transparent @border;
}

QStatusBar QLabel {
    background: transparent;
    margin-top: 2px;
    margin-bottom: 2px;
}


QFrame[height="3"], QFrame[width="3"] {
    background-color: @border_strong;
}


QSplitter::handle {
    border: 1px dashed @border;
}

QSplitter::handle:hover {
    background-color: @separator;
    border: 1px solid @border;
}

QSplitter::handle:horizontal {
    width: 1px;
    background-color: transparent;
}

QSplitter::handle:vertical {
    height: 1px;
    background-color: transparent;
}

QSplitter::handle:vertical:hover {
    background-color: @separator;
    border: 1px solid @border;
}

QSplitter::handle:horizontal:hover {
    background-color: @separator;
    border: 1px solid @border;
}

QSplitter {
    border: 0px;
}


/* ==========================================================================
   FRAME
   ==========================================================================
   A widget marked with fxstyle.mark_as_frame() is window chrome: it paints
   the frame colour, and the plain controls placed directly in it have no
   fill of their own. A framed FXMainWindow marks itself, its menu bar and
   its status bar; its toolbars are matched as its children. Nothing here
   matches an unmarked widget.
   ========================================================================== */

/* A framed window paints the frame behind its panes; a child it holds
   keeps the surface unless marked too. */
QMainWindow[fxFrame="true"] > QWidget
{
    background-color: @surface;
}

*[fxFrame="true"],
QMainWindow[fxFrame="true"] > QToolBar,
QMainWindow[fxFrame="true"] > *[fxFrame="true"]
{
    background-color: @frame;
}

QMenuBar[fxFrame="true"],
QStatusBar[fxFrame="true"],
QMainWindow[fxFrame="true"] > QToolBar
{
    border: none;
}

*[fxFrame="true"] > QLabel,
*[fxFrame="true"] > QCheckBox,
*[fxFrame="true"] > QRadioButton,
QMainWindow[fxFrame="true"] > QToolBar > QLabel,
QMainWindow[fxFrame="true"] > QToolBar > QCheckBox,
QMainWindow[fxFrame="true"] > QToolBar > QRadioButton
{
    background-color: transparent;
}

/* A framed FXMainWindow's icon and name, at the menu bar's right end. */
QWidget#fxMenuBarCorner,
QWidget#fxMenuBarCorner > QLabel
{
    background-color: transparent;
}

/* Tools added with add_corner_widget show the menu bar through. */
QWidget#fxMenuBarCorner QToolBar
{
    background: transparent;
    border: none;
    padding: 0px;
    spacing: 0px;
}

QWidget#fxMenuBarCorner QToolButton:disabled
{
    background-color: transparent;
}

*[fxFrame="true"] > QToolButton:disabled,
QMainWindow[fxFrame="true"] > QToolBar > QToolButton:disabled
{
    background-color: transparent;
    border-color: transparent;
}

/* The handle is the gap: no border, margin or padding, so it is exactly as
   wide as setHandleWidth() says. fxstyle paints its mark. */
QSplitter[fxFrame="true"]::handle,
QSplitter[fxFrame="true"]::handle:hover,
QSplitter[fxFrame="true"]::handle:horizontal,
QSplitter[fxFrame="true"]::handle:horizontal:hover,
QSplitter[fxFrame="true"]::handle:vertical,
QSplitter[fxFrame="true"]::handle:vertical:hover
{
    background-color: @frame;
    border: none;
    margin: 0px;
    padding: 0px;
}

/* A flat icon button: no box until hovered or pressed, and none when
   disabled. Its focus ring is in KEYBOARD FOCUS below. */
QPushButton[fxRole="flat"],
QPushButton[fxRole="flat"]:disabled
{
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px;
}

QPushButton[fxRole="flat"]:hover
{
    background-color: @state_hover;
}

QPushButton[fxRole="flat"]:pressed
{
    background-color: @state_pressed;
}


/* ==========================================================================
   KEYBOARD FOCUS
   ==========================================================================
   Focus is shown by changing something the widget already has, never by
   drawing a box around it. Qt's own focus rectangle is off (see `outline` on
   QWidget above) precisely because it ignores a widget's shape: on a tab it
   boxed the label inside the tab's own rounded lip.

   So each class speaks with the shape it already owns. A widget with a border
   recolours that border, which moves nothing because the border box does not
   change. A tab lights the one edge whose corners are already rounded, the
   side facing away from the pane, so the accent traces the tab's silhouette
   instead of fencing its text. A slider's handle recolours its edge.

   Rules live at the end of the file so they win over the base rules they
   recolour without needing extra specificity.

   One class is out of reach from here: an item view's current row. A
   `::item:focus` rule matches no pixels, so FXThumbnailDelegate draws that
   one, following the same rounded row shape it already paints its
   backgrounds with.
   ========================================================================== */

QLineEdit[fxFocusVisible="true"]:focus,
QTextEdit[fxFocusVisible="true"]:focus,
QTextBrowser[fxFocusVisible="true"]:focus,
QPlainTextEdit[fxFocusVisible="true"]:focus,
QComboBox[fxFocusVisible="true"]:focus,
QAbstractSpinBox[fxFocusVisible="true"]:focus,
QPushButton[fxFocusVisible="true"]:focus,
QGroupBox[fxFocusVisible="true"]:focus,
QAbstractItemView[fxFocusVisible="true"]:focus,
QTreeView[fxFocusVisible="true"]:focus,
QTreeWidget[fxFocusVisible="true"]:focus,
QListView[fxFocusVisible="true"]:focus,
QListWidget[fxFocusVisible="true"]:focus,
QTableView[fxFocusVisible="true"]:focus,
QTableWidget[fxFocusVisible="true"]:focus
{
    border-color: @accent_primary;
}

/* A plain QToolButton reserves a 1px border it does not paint, so the ring
   has to name a style as well as a colour. The width is unchanged, so the
   icon does not move. */
QToolButton[fxFocusVisible="true"]:focus,
QToolButton[popupMode="1"][fxFocusVisible="true"]:focus,
QToolButton[popupMode="2"][fxFocusVisible="true"]:focus
{
    border: 1px solid @accent_primary;
}

/* The handle's edge is the accent at rest, so focus rings it in @text.
   `QSlider:focus::handle` would match an unfocused slider too. */
QSlider[fxFocusVisible="true"]::handle:horizontal:focus,
QSlider[fxFocusVisible="true"]::handle:vertical:focus
{
    border-color: @text;
}

/* A tab has a shape already, so the accent goes on the edge whose corners are
   rounded, the side facing away from the pane. The pane-facing edge is
   deliberately merged into the pane by the rules above, and lighting it would
   cut the selected tab away from its own content. Every orientation already
   carries 1px there, so nothing moves. */
QTabBar[fxFocusVisible="true"]::tab:top:focus
{
    border-top-color: @accent_primary;
}

QTabBar[fxFocusVisible="true"]::tab:bottom:focus
{
    border-bottom-color: @accent_primary;
}

QTabBar[fxFocusVisible="true"]::tab:left:focus
{
    border-left-color: @accent_primary;
}

QTabBar[fxFocusVisible="true"]::tab:right:focus
{
    border-right-color: @accent_primary;
}

/* A checkbox and a radio button have no border of their own to recolour, so
   both states declare one and only the colour differs. The indicator's own
   focus artwork stays as it is; this ring is what carries the label. */
QCheckBox[fxFocusVisible="true"]:focus,
QRadioButton[fxFocusVisible="true"]:focus
{
    border-color: @accent_primary;
}

/* A primary button is filled with the accent, so its ring is the text. */
QPushButton[fxRole="primary"][fxFocusVisible="true"]:focus
{
    border-color: @text;
}

QPushButton[fxRole="flat"][fxFocusVisible="true"]:focus
{
    border-color: @accent_primary;
}
