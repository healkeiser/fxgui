/* A progress bar is the slider's groove: a 4 px pill, the done part the
   accent. Its text is off; a caller that wants it turns it back on. */
QProgressBar
{
    qproperty-textVisible: false;
    border: none;
    border-radius: 2px;
    padding: 0px;
    background: @control_edge;
}

/* By property: the :horizontal state does not reach the widget's size. */
QProgressBar[orientation="1"]
{
    max-height: 4px;
}

QProgressBar[orientation="2"]
{
    max-width: 4px;
}

QProgressBar::chunk
{
    border-radius: 2px;
    background-color: @accent_primary;
}

/* A tooltip is a popup card, as a menu is; fxstyle rounds its window. */
QToolTip
{
    border: 1px solid @border;
    background-color: @surface;
    color: @text;
    padding: 4px 10px;
    border-radius: @small_radius;
}

QWidget
{
    /* Qt gives a widget made under a styled parent the app palette, not the
       parent's, so the text inks live here rather than in the palette. */
    color: @text;
    selection-background-color: @selection;
    selection-color: @text_on_selection;
    background-clip: border;
    border-image: none;
    /* Qt's focus rectangle ignores a widget's shape; KEYBOARD FOCUS at the
       end of the file recolours each class's own edge instead. */
    outline: none;
}

/* Hover is a neutral fill, never the accent: the accent marks keyboard
   focus, the current item and the primary action; `selection` marks a
   selected item, the accent unless the theme names a softer fill. */
QWidget:item:hover
{
    background-color: @state_hover;
    color: @text;
}

QWidget:item:selected
{
    background-color: @selection;
    color: @text_on_selection;
}

QCheckBox
{
    spacing: 8px;
    color: @text;
    margin-bottom: 2px;
    /* Reserved for the focus ring, which only recolours it, so the label
       never shifts on focus. */
    border: 1px solid transparent;
    border-radius: @small_radius;
}

QCheckBox:disabled
{
    color: @text_disabled;
}
/* An on/off mark is drawn, not an image: Lumen's 1 px edge with the small
   corner, filled orange with a dark Lucide check once on. The border sits
   inside the indicator size, so a mark keeps its box in every state. */
QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator,
QRadioButton::indicator
{
    width: @indicator_inner;
    height: @indicator_inner;
    border: 1px solid @border_light;
    border-radius: @small_radius;
    background: transparent;
    image: none;
}

QRadioButton::indicator
{
    border-radius: @indicator_round;
}

QGroupBox::indicator
{
    margin-left: 2px;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QRadioButton::indicator:hover,
QCheckBox::indicator:pressed,
QGroupBox::indicator:pressed,
QRadioButton::indicator:pressed
{
    border-color: @border_strong;
}

QCheckBox[fxFocusVisible="true"]::indicator:focus,
QGroupBox[fxFocusVisible="true"]::indicator:focus,
QRadioButton[fxFocusVisible="true"]::indicator:focus
{
    border-color: @accent_primary;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked
{
    background: @accent_primary;
    border-color: @accent_primary;
    image: ~icon(check, text_on_accent_primary, 16);
}

QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate
{
    background: @accent_primary;
    border-color: @accent_primary;
    image: ~icon(remove, text_on_accent_primary, 16);
}

/* A radio's dot is the dark ink at the middle of the orange disc. */
QRadioButton::indicator:checked
{
    border-color: @accent_primary;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 @text_on_accent_primary, stop: 0.36 @text_on_accent_primary,
        stop: 0.42 @accent_primary, stop: 1 @accent_primary);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled,
QRadioButton::indicator:disabled
{
    border-color: @border;
}

QCheckBox::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled,
QGroupBox::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled
{
    background: @border_light;
    border-color: @border_light;
    image: ~icon(check, text_disabled, 16);
}

QRadioButton::indicator:checked:disabled
{
    border-color: @border_light;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 @text_disabled, stop: 0.36 @text_disabled,
        stop: 0.42 @border_light, stop: 1 @border_light);
}

QRadioButton
{
    spacing: 8px;
    color: @text;
    margin-bottom: 2px;
    /* Reserved for the focus ring, which only recolours it. Declaring the
       border in both states is what stops the label shifting on focus. */
    border: 1px solid transparent;
    border-radius: @small_radius;
}

QRadioButton:disabled
{
    color: @text_disabled;
}


QMenuBar
{
    background-color: @surface_sunken;
    border-bottom: 1px solid @scrollbar_track;
}

/* One box in every state, so an item never changes shape. An open menu is
   the pressed fill, not the accent. `:enabled` lifts these over the
   `QWidget:item:selected` rule above. */
QMenuBar::item
{
    background: transparent;
    margin: 5px;
    padding: 4px 8px;
    border-radius: @button_radius;
}

QMenuBar::item:selected:enabled,
QMenuBar::item:hover:enabled
{
    color: @text;
    background-color: @state_hover;
}

QMenuBar::item:pressed:enabled
{
    color: @text;
    background-color: @state_pressed;
}

/* One popup look for a menu, a combo box's list and the command palette:
   @surface, the popup border, items inset in it, card corners. fxstyle asks
   the platform for flyout corners when a themed popup shows. */
QMenu
{
    border: 1px solid @border;
    border-radius: @card_radius;
    color: @text;
    background-color: @surface;
    padding: 4px;
}

QMenu::icon
{
    /* Qt centres the icon on the whole box but draws the :checked frame
       inside the margins; near-even margins put both in one place. */
    margin-left: 12px;
    margin-right: 13px;
}

/* Qt draws a checkable action's icon instead of its check box, so the
   icon carries the checked state, on a fill and no edge: a sheet's 1px
   round edge comes out jagged. */
QMenu::icon:checked
{
    background-color: @state_pressed;
    border: 1px solid transparent;
    border-radius: @small_radius;
}

/* Its line as a list popup's row measures it, so the two stand alike. The
   pointer's item is a neutral fill, as a hovered row's: the accent is kept
   for what is chosen. */
QMenu::item
{
    background-color: transparent;
    border: none;
    border-radius: @button_radius;
    padding: 8px 24px;
    min-height: @text_line;
}

QMenu::item:selected
{
    color: @text;
    background-color: @state_hover;
}

QMenu::item:pressed
{
    color: @text;
    background-color: @state_pressed;
}

/* Full width inside the menu's padding. */
QMenu::separator {
    height: 1px;
    background-color: @border;
    margin: 4px 0px;
}

QMenu::indicator {
    width: 18px;
    height: 18px;
    /* Centres an 18 px box on the 16 px icon QMenu::icon places. */
    position: relative;
    left: 12px;
}

/* A checkable menu row is Lumen's: a check when on, nothing when off,
   for a toggle and a one-of-many pick alike. */
QMenu::indicator:unchecked {
    image: none;
}

QMenu::indicator:checked {
    image: ~icon(check, text, 16);
}

QMenu::right-arrow {
    margin: 5px;
    width: 16px;
    height: 16px;
    image: ~icon(chevron_right, icon);
}

QMenu::right-arrow:selected {
    image: ~icon(chevron_right, icon);
}


QWidget:disabled
{
    color: @text_disabled;
}

QAbstractItemView
{
    /* Rows are told apart by hover and selection, never by stripes. The
       alternate colour stays for what Qt paints in it: a calendar's header. */
    qproperty-alternatingRowColors: false;
    alternate-background-color: @surface_alt;
    color: @text;
    background-color: @surface_sunken;
    border: 1px solid @border;
    border-radius: @button_radius;
    padding: 1px;
    /* Pixel scrolling, set at polish; a view that wants rows names
       ScrollPerItem in a rule of its own, by objectName. */
    qproperty-verticalScrollMode: ScrollPerPixel;
    qproperty-horizontalScrollMode: ScrollPerPixel;
}

QMenuBar:focus
{
    border: none;
}

/* A field is Lumen's outline: no fill of its own, a hairline edge, and
   the accent edge under keyboard focus. */
QLineEdit
{
    background-color: transparent;
    padding: 4px 8px;
    border-style: solid;
    border: 1px solid @border_light;
    border-radius: @button_radius;
    color: @text;
    /* A push button's height in the theme's font, worked out by fxstyle. */
    min-height: @field_inner;
    max-height: @field_inner;
}

/* A box's own field, or a cell's editor, takes the room it is given. */
QComboBox QLineEdit,
QAbstractSpinBox QLineEdit,
QAbstractItemView QLineEdit
{
    min-height: 0px;
    max-height: 16777215px;
}

/* A search bar is Lumen's ghost field: no edge, filled while hovered or
   typed in. */
QLineEdit[fxGhost="true"]
{
    border-color: transparent;
}

QLineEdit[fxGhost="true"]:hover,
QLineEdit[fxGhost="true"]:focus
{
    background-color: @state_pressed;
}

/* The title sits in the margin above a whole card, never cut into its
   border; the margin is in em so it grows with the font. */
QGroupBox {
    border: 1px solid @border;
    border-radius: @button_radius;
    margin-top: 1.75em;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 2px;
}

/* A scroll bar is a pill on whatever it scrolls: no track, no arrows. The
   bar keeps one width, so the thumb widens inside it on hover and nothing
   beside it moves. */
QWidget#qt_scrollarea_hcontainer,
QWidget#qt_scrollarea_vcontainer,
QAbstractScrollArea::corner
{
    background: transparent;
    border: none;
}

QScrollBar:vertical,
QScrollBar:horizontal
{
    background: transparent;
    border: none;
    margin: 0px;
}

QScrollBar:vertical
{
    width: @thin_scroll;
}

QScrollBar:horizontal
{
    height: @thin_scroll;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal
{
    background: @scrollbar_thumb;
    border-radius: 2px;
}

QScrollBar::handle:vertical
{
    min-height: 24px;
    margin: 0px 2px;
}

QScrollBar::handle:horizontal
{
    min-width: 24px;
    margin: 2px 0px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed
{
    background: @scrollbar_thumb_hover;
    border-radius: @thin_scroll_radius;
    margin: 0px;
}

QScrollBar::add-line,
QScrollBar::sub-line
{
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page
{
    background: none;
}

/* A thin scroll area (fxstyle.mark_as_thin_scroll) sits on its card. */
[fxThinScroll="true"],
[fxThinScroll="true"] > QWidget#qt_scrollarea_viewport
{
    background: transparent;
    border: none;
}

QSizeGrip {
    background: transparent;
    width: 0;
    height: 0;
}


/* The workspace behind MDI windows, a property Qt paints itself. */
QMdiArea
{
    qproperty-background: @frame;
}

/* A gap between docks or panes shows nothing until the pointer finds it. */
QMainWindow::separator
{
    background-color: transparent;
    border: none;
}

QMainWindow::separator:hover
{
    background-color: @accent_primary;
}


QFrame
{
    border-radius: @button_radius;
}

QFrame[frameShape="0"]
{
    border-radius: @button_radius;
    border: 1px transparent @border_strong;
}

/* HLine and VLine: one flat pixel, not Qt's two-tone bevel, which reads as
   a groove on a dark panel. */
QFrame[frameShape="4"]
{
    border: none;
    background-color: @border;
    min-height: 1px;
    max-height: 1px;
}

QFrame[frameShape="5"]
{
    border: none;
    background-color: @border;
    min-width: 1px;
    max-width: 1px;
}

QStackedWidget
{
    border: 1px transparent;
}

/* After QFrame, so the edge wins. */
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: @surface_sunken;
    color: @text;
    border: 1px solid @border;
    border-radius: @button_radius;
}

QTextEdit#fxOutputLogArea {
    font-family: @font_mono;
    font-size: 9pt;
}

QToolBar {
    border: 1px transparent @border_strong;
    background: 1px solid @surface;
    font-weight: bold;
    border-bottom: 1px solid @border;
}

QToolBar::handle:horizontal {
    image: url(~icons/horizontal_move_toolbar.svg);
    width: 18px;
    height: 18px;
}
QToolBar::handle:vertical {
    image: url(~icons/vertical_move_toolbar.svg);
    width: 18px;
    height: 18px;
}
QToolBar::separator:horizontal {
    image: url(~icons/horizontal_separator_toolbar.svg);
    width: 18px;
    height: 18px;
}
QToolBar::separator:vertical {
    image: url(~icons/vertical_separator_toolbar.svg);
    width: 18px;
    height: 18px;
}

/* A button is an outline on whatever it sits on: a hairline ring, no
   fill until hovered, then Lumen's raised grey. */
QPushButton
{
    color: @text;
    background-color: transparent;
    border-width: 1px;
    border-color: @border_light;
    border-style: solid;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: @button_radius;
}

QPushButton:disabled
{
    background-color: transparent;
    border-color: @border;
    color: @text_disabled;
}

/* A flat push button (setFlat) is a bare icon: no edge, a fill on hover,
   the pressed fill held while checked. */
QPushButton:flat,
QPushButton:flat:disabled,
QPushButton:flat:focus
{
    background-color: transparent;
    border-color: transparent;
}

QPushButton:flat:hover
{
    background-color: @state_pressed;
}

QPushButton:flat:pressed,
QPushButton:flat:checked
{
    background-color: @state_pressed;
}

QPushButton:focus {
    border: 1px solid @border_light;
}

QComboBox
{
    selection-background-color: @selection;
    background-color: transparent;
    border-style: solid;
    border: 1px solid @border_light;
    border-radius: @button_radius;
    padding: 4px 6px;
    min-width: 75px;
    min-height: @field_inner;
    max-height: @field_inner;
    /* A list popup: the menu-style one ticks and indents the current row. */
    combobox-popup: 0;
}

QPushButton:checked{
    background-color: @state_pressed;
    border-color: @grid;
}

/* A button hovers by its fill alone, so it never looks focused. */
QPushButton:hover
{
    background-color: @state_pressed;
    color: @text;
}


/* A completer's list is the popup card, as a menu is. The padding is what
   Qt's popup height leaves, so its rows show without a scroll. */
QAbstractItemView[fxPopup="true"]
{
    background-color: @surface;
    border: 1px solid @border;
    border-radius: @card_radius;
    padding: 2px 4px;
    margin: 0px;
}

/* A combo box's list sits in a frame fxstyle paints as the same card. */
QComboBox QAbstractItemView
{
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 2px 4px;
    margin: 0px;
}

/* Every arrow is the accordion's chevron in @icon: here, on a spin box,
   a header's sort mark, a menu, a tab bar's scroll buttons, a tool button
   and a push button with a menu. */
QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: none;
}

QComboBox::down-arrow
{
    image: ~icon(expand_more, icon);
    width: 16px;
    height: 16px;
}

QComboBox::down-arrow:disabled
{
    image: ~icon(expand_more, text_disabled);
}

/* A date edit with a calendar popup opens it from a combo box's arrow. */
QDateTimeEdit::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: none;
}

QDateTimeEdit::down-arrow
{
    image: ~icon(expand_more, icon);
    width: 16px;
    height: 16px;
}

QDateTimeEdit::down-arrow:disabled
{
    image: ~icon(expand_more, text_disabled);
}

QCalendarWidget QToolButton#qt_calendar_prevmonth
{
    qproperty-icon: ~icon(chevron_left, icon);
    qproperty-iconSize: 16px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth
{
    qproperty-icon: ~icon(chevron_right, icon);
    qproperty-iconSize: 16px;
}

QPushButton:pressed
{
    background-color: @state_pressed;
}

/* FXPrimaryButton, or any QPushButton with fxRole="primary". The fills are
   the accents shifted until their text reads at 4.5:1 (see fxstyle). */
QPushButton[fxRole="primary"]
{
    color: @text_on_accent_primary;
    background-color: @primary_button;
    border-color: @primary_button;
}

QPushButton[fxRole="primary"]:hover
{
    color: @text_on_accent_secondary;
    background-color: @primary_button_hover;
    border-color: @primary_button_hover;
}

/* After :hover, so a hovered press draws the text its fill was tuned for. */
QPushButton[fxRole="primary"]:pressed
{
    color: @text_on_accent_primary;
    background-color: @primary_button_pressed;
    border-color: @primary_button_pressed;
}

/* A dialog's buttons are Lumen's: Cancel first, bare words with no icon;
   fxstyle makes the accepting verb the primary button. */
QDialogButtonBox
{
    button-layout: 1;
    dialogbuttonbox-buttons-have-icons: 0;
}

QDialogButtonBox QPushButton,
QDialogButtonBox QPushButton:focus
{
    border-color: transparent;
}

QPushButton[fxRole="primary"]:disabled
{
    color: @text_disabled;
    background-color: @surface_alt;
    border-color: @border;
}

QAbstractSpinBox {
    /* A push button's height: fxstyle works the padding out per font and Qt. */
    padding: @spin_padding;
    border: 1px solid @border_light;
    background-color: transparent;
    color: @text;
    border-radius: @button_radius;
    min-width: 75px;
}

/* A number box has no step arrows, as Lumen's: the wheel and the arrow
   keys step it. */
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button
{
    width: 0px;
    border: none;
}

QAbstractSpinBox::up-arrow,
QAbstractSpinBox::down-arrow
{
    image: none;
    width: 0px;
    height: 0px;
}

QLabel
{
    border: 0px solid;
}

/* A tab widget is one pane card around its tabs and its page, as a dock
   pane is: the page sits right under the tab strip and one gap off the
   card's other edges, as a dock pane's content does. A document-mode
   tab widget is a window's own strip and draws no card. */
QTabWidget {
    background: @surface;
    border: 1px solid @pane_border;
    border-radius: @button_radius;
}

QTabWidget[documentMode="true"] {
    background: transparent;
    border: none;
}

QTabWidget::pane {
    top: 0px;
    background: transparent;
    border: none;
    padding: 1px @pane_gap @pane_gap @pane_gap;
}

/* The tabs start past the card's 1 px edge, as a dock pane's do inside its. */
QTabWidget::tab-bar {
    left: 1px;
    top: 1px;
}

/* One tab look for QTabBar and QtAds: bare @text_muted text, and the current
   tab a small rounded pill in @state_pressed with @text, with no edge. A
   hovered tab shows the lighter @state_hover pill and keeps its muted text;
   a hovered current tab keeps its own fill. Every tab keeps a transparent
   1px edge, so nothing moves. QtAds tabs name activeTab to outrank
   QFrame[frameShape]. A tab is its text plus the padding: never elided,
   never stretched; a full bar scrolls. */
QTabBar
{
    qproperty-drawBase: 0;
    qproperty-elideMode: ElideNone;
    qproperty-usesScrollButtons: true;
    qproperty-expanding: false;
    background: transparent;
}

QTabBar::tab,
ads--CDockWidgetTab[activeTab="false"],
ads--CDockWidgetTab[activeTab="true"]
{
    color: @text_muted;
    background: transparent;
    border: 1px solid transparent;
    border-radius: @button_radius;
    /* One gap above, below and between pills: twice the side margin. */
    margin: @pane_gap @pane_gap_half;
    padding: 3px @tab_padding;
    /* A dock tab's title is a label, which rounds its line up: so does a
       tab bar's, or the two stand a pixel apart on some fonts. */
    min-height: @text_line;
}

/* The first pill stands as far off the strip's start as off its top. */
QTabBar::tab:first,
QTabBar::tab:only-one
{
    margin-left: @pane_gap;
}

/* Hover shows a lighter pill; the text keeps its ink. */
QTabBar::tab:hover,
ads--CDockWidgetTab[activeTab="false"]:hover
{
    background: @state_hover;
}

QTabBar::tab:selected,
ads--CDockWidgetTab[activeTab="true"]
{
    color: @text;
    background: @state_pressed;
}

ads--CDockWidgetTab QLabel
{
    background: transparent;
    color: @text_muted;
}

ads--CDockWidgetTab[activeTab="true"] QLabel
{
    color: @text;
}

/* The scroll buttons sit on the strip as the tabs do. Qt draws them over
   the last tab, so they are opaque, and a left edge in the strip's colour
   keeps a gap between that tab's cut text and the arrows. */
QTabBar QToolButton {
    background-color: @surface;
    border: none;
    border-left: 8px solid @surface;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
}

/* Both buttons together: each an 8px gap and its 16px arrow. */
QTabBar::scroller {
    width: 48px;
}

QTabBar QToolButton:hover,
QTabBar QToolButton:pressed {
    background-color: @state_hover;
}

QTabBar QToolButton::right-arrow,
QTabBar QToolButton::left-arrow {
    width: 16px;
    height: 16px;
}

QTabBar QToolButton::right-arrow {
    image: ~icon(chevron_right, icon);
}

QTabBar QToolButton::left-arrow {
    image: ~icon(chevron_left, icon);
}

QTabBar QToolButton::right-arrow:disabled {
    image: ~icon(chevron_right, text_disabled);
}

QTabBar QToolButton::left-arrow:disabled {
    image: ~icon(chevron_left, text_disabled);
}

/* The glyph keeps its button's left: the button widens to the left.
   20 px is Fusion's close button; a smaller style's shrinks the glyph. */
QTabBar::close-button  {
    image: url(~icons/close.svg, 20);
    image-position: left;
    background: transparent;
}

QTabBar::close-button:hover
{
    image: url(~icons/close_hover.svg, 20);
    background: transparent;
}

QTabBar::close-button:pressed {
    image: url(~icons/close_pressed.svg, 20);
    background: transparent;
}


/* A plain dock widget reads as a dock pane: a flat title in the tab text. */
QDockWidget {
    color: @text;
    titlebar-close-icon: url(~icons/close.svg, 16);
    titlebar-normal-icon: url(~icons/undock.svg, 16);
}

QDockWidget::title {
    text-align: left;
    background-color: @surface;
    border: none;
    padding: 6px 10px;
    padding-right: 60px;
}

QDockWidget::close-button {
    border: 1px solid transparent;
    border-radius: @button_radius;
    background: transparent;
    subcontrol-origin: margin;
    subcontrol-position: top right;
    position: absolute;
    top: 4px;
    right: 4px;
    width: 20px;
    height: 20px;
}

QDockWidget::float-button {
    border: 1px solid transparent;
    border-radius: @button_radius;
    background: transparent;
    subcontrol-origin: margin;
    subcontrol-position: top right;
    position: absolute;
    top: 4px;
    right: 28px;
    width: 20px;
    height: 20px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: @state_pressed;
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    padding: 1px -1px -1px 1px;
    background: @state_pressed;
}


/* Item views inherit from QAbstractItemView above */
/* Use show-decoration-selected: 1 so the entire row gets consistent
   highlighting. Branch uses @surface_sunken to match item background
   (Qt ignores 'transparent' for branch selection/hover painting). */
QTreeView::branch {
    background: @surface_sunken;
}

/* Override branch background to stay neutral during selection/hover
   since the delegate handles item painting, not the branch area */
QTreeView::branch:selected,
QTreeView::branch:!selected:hover {
    background: @surface_sunken;
}

/* No branch lines; a parent shows the accordion's chevron, in the 16 px
   box of an item's icon. This padding fits a 20 px indentation; fxstyle
   adds one rule per indentation for any other width. */
QTreeView::branch:has-children {
    padding: 2px;
}

QTreeView::branch:has-children:closed {
    image: ~icon(chevron_right, icon);
}

QTreeView::branch:has-children:open {
    image: ~icon(expand_more, icon);
}

/* A row has no padding in any state: Qt 6.5 skips an item's padding on
   a row it paints natively and honours it on a highlighted one. Nor has
   the view: its rows run from its very top, edge to edge. */
QListView,
QTreeView,
QTableView {
    show-decoration-selected: 1;
    padding: 0px;
}

/* A branch slides open and shut. */
QTreeView {
    qproperty-animated: true;
}

QListView::item {
    padding: 0px;
    min-height: 28px;
    max-height: 28px;
}

/* A canvas is framed as a list is: one hairline, the control's corner.
   Qt's own frame would be a bevel, light on two sides and dark on two. */
QGraphicsView
{
    border: 1px solid @border;
    border-radius: @button_radius;
}

/* A tree row is a table's: flat, and as tall as the row size in force. */
QTreeView::item {
    padding: 0px;
    min-height: @row_height;
    max-height: @row_height;
}

/* A radius makes the sheet draw the whole cell, which hides an item's own
   BackgroundRole; only a list's highlighted rows carry one. */
QListView::item:hover,
QListView::item:selected {
    border-radius: @button_radius;
}

/* Qt 6.6 sets a resting list row's text 1 px further right than a
   highlighted one, which the sheet draws: the token makes up the step. */
QListView::item:hover,
QListView::item:selected {
    padding-left: @list_text_step;
}

QListView::item:!selected:hover,
QTreeView::item:!selected:hover {
    background: @state_hover;
    color: @text;
}

QListView::item:selected:hover,
QTreeView::item:selected:hover {
    background: @selection;
    color: @text_on_selection;
}

/* A popup list's rows are a menu's: its line and 8 px above and below,
   at most 32 px whatever the base style asks (Windows 11 asks 34 px), and the
   pointer's row the neutral fill. After the view rules above, which match
   as specifically. */
QComboBox QAbstractItemView::item,
QAbstractItemView[fxPopup="true"]::item {
    padding: 8px 0px;
    min-height: 0px;
    max-height: @row_line;
}

/* A combo box's rows draw no native border for a host's margin to undo. */
QComboBox QAbstractItemView::item {
    margin: 0px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:!selected:hover,
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:selected:active,
QAbstractItemView[fxPopup="true"]::item:hover,
QAbstractItemView[fxPopup="true"]::item:selected,
QAbstractItemView[fxPopup="true"]::item:selected:active {
    color: @text;
    background: @state_hover;
    /* A popup row is a menu's: no list text step. */
    padding-left: 0px;
}

/* A navigation list (mark_as_nav): 28 px rounded chips set in from the
   edges, no rule between them; the current row a neutral chip with its
   text in the accent, a hovered one the same chip in the text's ink.
   mark_as_nav sets the gap at the ends. */

QTreeView[fxNav="true"]::item,
QListView[fxNav="true"]::item {
    min-height: 28px;
    max-height: 28px;
    border: none;
    border-radius: @button_radius;
    margin: 1px 4px;
}

QTreeView[fxNav="true"]::item:!selected:hover,
QListView[fxNav="true"]::item:!selected:hover {
    background: @state_hover;
    color: @text;
}

QTreeView[fxNav="true"]::item:selected,
QTreeView[fxNav="true"]::item:selected:active,
QTreeView[fxNav="true"]::item:selected:hover,
QListView[fxNav="true"]::item:selected,
QListView[fxNav="true"]::item:selected:active,
QListView[fxNav="true"]::item:selected:hover {
    background: @state_hover;
    color: @nav_ink;
}

/* A slider is a 4 px pill, its filled span the accent, and a round handle:
   surface fill and accent edge, a thicker edge on hover, an accent fill while
   pressed. The handle overhangs the groove by a negative margin, and the
   slider is as thick as an indicator so the handle is never clipped. A
   handle's width excludes its border, so every state keeps a 16 px box and
   the handle never shifts along the groove. The empty groove is
   @control_edge, 3:1 on the surface; the span is told from it by hue and
   by the handle, since both cannot also read 3:1 on each other. */
QSlider:horizontal {
    min-height: @indicator_size;
}

QSlider:vertical {
    min-width: @indicator_size;
}

QSlider::groove:horizontal,
QSlider::sub-page:horizontal {
    border: none;
    height: 4px;
    margin: 0;
    background: @control_edge;
    border-radius: 2px;
}

QSlider::groove:vertical,
QSlider::add-page:vertical {
    border: none;
    width: 4px;
    margin: 0;
    background: @control_edge;
    border-radius: 2px;
}

/* A vertical slider fills from the bottom, which is its add-page. */
QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background: @accent_primary;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background: @surface;
    border: 2px solid @accent_primary;
    width: 12px;
    height: 12px;
    border-radius: 8px;
}

QSlider::handle:horizontal {
    margin: -6px 0;
}

QSlider::handle:vertical {
    margin: 0 -6px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    border-width: 4px;
    width: 8px;
    height: 8px;
}

QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: @accent_primary;
}

QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: @surface;
    border-color: @border;
}

QSlider::sub-page:horizontal:disabled,
QSlider::add-page:vertical:disabled {
    background: @border_strong;
}

/* Plain QToolButtons (toolbars, icon buttons) stay flat: transparent
   until hovered, a 22 px box around a 16 px icon. Split buttons
   (MenuButtonPopup) read like QPushButtons: see popupMode="1" below. */
QToolButton {
    background-color: transparent;
    /* Reserved for the checked and focus edges, so neither moves the icon. */
    border: 1px solid transparent;
    border-radius: @button_radius;
    margin: 2px;
    padding: 2px;
}

QToolButton[popupMode="1"] { /* MenuButtonPopup: QPushButton look */
    color: @text;
    background-color: transparent;
    border: 1px solid @border;
    border-radius: @button_radius;
    margin: 0px;
    padding: 6px 10px;
    padding-right: 22px; /* room for the menu-button section */
}

QToolButton[popupMode="1"]:disabled {
    background-color: transparent;
    border: 1px solid @border;
    color: @text_disabled;
}

QToolButton[popupMode="2"] { /* only for InstantPopup */
    padding-right: 12px; /* make way for the indicator */
}

/* Hover is the neutral fill and keeps the edge and the ink; a split button
   hovers as a QPushButton, its arrow part included. */
QToolButton:hover,
QToolButton[popupMode="1"]:hover {
    background-color: @state_hover;
}

/* The button's own fill shows through, and its border stays whole. */
QToolButton::menu-button:hover {
    background-color: transparent;
}

QToolButton:pressed,
QToolButton::menu-button:pressed {
    background-color: @state_pressed;
}

/* A toggle that is on fills, with no edge: a sheet's 1px round edge
   comes out jagged. */
QToolButton:checked {
    background-color: @state_pressed;
    border-color: transparent;
}

/* the subcontrol below is used only in the InstantPopup or DelayedPopup mode */
QToolButton::menu-indicator {
    image: ~icon(expand_more, icon, 12);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 2px;
}

/* the subcontrols below are used only in the MenuButtonPopup mode */
QToolButton::menu-button {
    border: none;
    border-left: 1px solid @border_light;
    border-top-right-radius: @button_radius;
    border-bottom-right-radius: @button_radius;
    width: 12px;
}

QToolButton::menu-arrow {
    image: ~icon(expand_more, icon, 12);
    width: 12px;
    height: 12px;
}

QToolButton::menu-arrow:disabled {
    image: ~icon(expand_more, text_disabled, 12);
}


QPushButton::menu-indicator  {
    image: ~icon(expand_more, icon, 12);
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 12px;
    height: 12px;
}

QPushButton::menu-indicator:disabled {
    image: ~icon(expand_more, text_disabled, 12);
}


/* No grid: FXProxyStyle draws a hairline under each row, as Lumen's. A
   rule in the sheet would make it draw the whole cell over a cell's own
   BackgroundRole. */
QTableView
{
    gridline-color: @grid;
    qproperty-showGrid: false;
}


QTableView::item:pressed,
QListView::item:pressed,
QTreeView::item:pressed  {
    border-color: @selection;
    background: @selection;
    color: @text_on_selection;
}

QTableView::item:selected:active,
QTreeView::item:selected:active,
QListView::item:selected:active  {
    background: @selection;
    color: @text_on_selection;
}


/* A keycap is Lumen's: two steps below the body. Its look is FXKeycap's
   own rule; the size lives here, with the type scale. */
QLabel#fxKeycap
{
    font-size: @font_size_tiny;
}

/* A header is Lumen's: flat muted text over one rule, no line between
   columns, labels on the left a step below the body. */
QHeaderView
{
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
    qproperty-defaultAlignment: "AlignLeft|AlignVCenter";
}

QHeaderView::section  {
    background-color: transparent;
    color: @text_muted;
    font-size: @font_size_small;
    /* Left in line with a cell's text, which sits 4 px in. */
    padding: 8px 4px;
    border: none;
    border-bottom: 1px solid @border;
    border-radius: 0px;
}

QHeaderView::section:vertical
{
    border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}

QHeaderView::section:vertical:last,
QHeaderView::section:vertical:only-one
{
    border-bottom: none;
}

QHeaderView::section:checked
{
    color: @text;
}

/* No sort-arrow rule: FXProxyStyle draws it right after the label, as
   Lumen's, where a sheet can only pin it to the section's end. */

QTableCornerButton::section {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}


QToolBox  {
    padding: 3px;
    border: 1px transparent;
}

/* A section header: no box, a chevron at the left, a hover fill, the open
   one in the section weight. */
QToolBox::tab {
    color: @text;
    background-color: transparent;
    border: none;
    border-radius: @button_radius;
    min-height: 28px;
    padding-left: 4px;
    image: ~icon(chevron_right, icon);
    image-position: left;
}

QToolBox::tab:hover {
    background-color: @state_hover;
}

QToolBox::tab:selected {
    font-weight: 600;
    image: ~icon(expand_more, icon);
}


QStatusBar {
    background-color: @surface_sunken;
    border-top: 1px solid @scrollbar_track;
}

QStatusBar::item {
    background: transparent;
    border: 1px transparent @border;
}

QStatusBar QLabel {
    background: transparent;
    margin-top: 2px;
    margin-bottom: 2px;
}


QFrame[height="3"], QFrame[width="3"] {
    background-color: @border_strong;
}


/* A handle shows nothing until the pointer finds it, as a dock gap. */
QSplitter::handle {
    background-color: transparent;
    border: none;
}

/* A splitter inside a pane leaves its two sides a gutter of breathing
   room; under the pointer, a thin accent line down its middle says it
   drags, as a column's resize edge does. */
QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 8px;
}

QSplitter::handle:horizontal:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 transparent, stop: 0.374 transparent,
        stop: 0.375 @accent_primary, stop: 0.625 @accent_primary,
        stop: 0.626 transparent, stop: 1 transparent);
}

QSplitter::handle:vertical:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 transparent, stop: 0.374 transparent,
        stop: 0.375 @accent_primary, stop: 0.625 @accent_primary,
        stop: 0.626 transparent, stop: 1 transparent);
}

QSplitter {
    border: 0px;
}


/* ==========================================================================
   FRAME
   ==========================================================================
   A widget marked with fxstyle.mark_as_frame() is window chrome: it paints
   the frame colour, and the plain controls placed directly in it have no
   fill of their own. A framed FXMainWindow marks itself, its menu bar and
   its status bar; its toolbars are matched as its children. Nothing here
   matches an unmarked widget.
   ========================================================================== */

/* A framed window paints the frame behind its panes; a child it holds
   keeps the surface unless marked too. */
QMainWindow[fxFrame="true"] > QWidget
{
    background-color: @surface;
}

*[fxFrame="true"],
QMainWindow[fxFrame="true"] > QToolBar,
QMainWindow[fxFrame="true"] > *[fxFrame="true"]
{
    background-color: @frame;
}

QMenuBar[fxFrame="true"],
QStatusBar[fxFrame="true"],
QMainWindow[fxFrame="true"] > QToolBar
{
    border: none;
}

*[fxFrame="true"] > QLabel,
*[fxFrame="true"] > QCheckBox,
*[fxFrame="true"] > QRadioButton,
QMainWindow[fxFrame="true"] > QToolBar > QLabel,
QMainWindow[fxFrame="true"] > QToolBar > QCheckBox,
QMainWindow[fxFrame="true"] > QToolBar > QRadioButton
{
    background-color: transparent;
}

/* A framed FXMainWindow's icon and name, at the menu bar's right end. */
QWidget#fxMenuBarCorner,
QWidget#fxMenuBarCorner > QLabel
{
    background-color: transparent;
}

/* Tools added with add_corner_widget show the menu bar through. */
QWidget#fxMenuBarCorner QToolBar
{
    background: transparent;
    border: none;
    padding: 0px;
    spacing: 0px;
}

QWidget#fxMenuBarCorner QToolButton:disabled
{
    background-color: transparent;
}

*[fxFrame="true"] > QToolButton:disabled,
QMainWindow[fxFrame="true"] > QToolBar > QToolButton:disabled
{
    background-color: transparent;
    border-color: transparent;
}

/* The handle is the gap: no border, margin or padding, so it is exactly as
   wide as setHandleWidth() says. fxstyle paints its mark. */
QSplitter[fxFrame="true"]::handle,
QSplitter[fxFrame="true"]::handle:hover,
QSplitter[fxFrame="true"]::handle:horizontal,
QSplitter[fxFrame="true"]::handle:horizontal:hover,
QSplitter[fxFrame="true"]::handle:vertical,
QSplitter[fxFrame="true"]::handle:vertical:hover
{
    background-color: @frame;
    border: none;
    margin: 0px;
    padding: 0px;
}

/* A flat icon button: no box until hovered or pressed, and none when
   disabled. Its focus ring is in KEYBOARD FOCUS below. */
QPushButton[fxRole="flat"],
QPushButton[fxRole="flat"]:disabled
{
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px;
}

QPushButton[fxRole="flat"]:hover
{
    background-color: @state_hover;
}

QPushButton[fxRole="flat"]:pressed
{
    background-color: @state_pressed;
}


/* ==========================================================================
   KEYBOARD FOCUS
   ==========================================================================
   Focus is shown by changing something the widget already has, never by
   drawing a box around it. Qt's own focus rectangle is off (see `outline` on
   QWidget above) because it ignores a widget's shape.

   So each class speaks with the shape it already owns. A widget with a border
   recolours that border, which moves nothing because the border box does not
   change. A tab recolours its bar. A slider's handle recolours its edge.

   Rules live at the end of the file so they win over the base rules they
   recolour without needing extra specificity.

   One class is out of reach from here: an item view's current row. A
   `::item:focus` rule matches no pixels, so FXThumbnailDelegate draws that
   one, following the same rounded row shape it already paints its
   backgrounds with.
   ========================================================================== */

QLineEdit[fxFocusVisible="true"]:focus,
QTextEdit[fxFocusVisible="true"]:focus,
QTextBrowser[fxFocusVisible="true"]:focus,
QPlainTextEdit[fxFocusVisible="true"]:focus,
QComboBox[fxFocusVisible="true"]:focus,
QAbstractSpinBox[fxFocusVisible="true"]:focus,
QPushButton[fxFocusVisible="true"]:focus,
QGroupBox[fxFocusVisible="true"]:focus,
QAbstractItemView[fxFocusVisible="true"]:focus,
QTreeView[fxFocusVisible="true"]:focus,
QTreeWidget[fxFocusVisible="true"]:focus,
QListView[fxFocusVisible="true"]:focus,
QListWidget[fxFocusVisible="true"]:focus,
QTableView[fxFocusVisible="true"]:focus,
QTableWidget[fxFocusVisible="true"]:focus
{
    border-color: @accent_primary;
}

/* A plain QToolButton reserves a 1px border it does not paint, so the ring
   has to name a style as well as a colour. The width is unchanged, so the
   icon does not move. */
QToolButton[fxFocusVisible="true"]:focus,
QToolButton[popupMode="1"][fxFocusVisible="true"]:focus,
QToolButton[popupMode="2"][fxFocusVisible="true"]:focus
{
    border: 1px solid @accent_primary;
}

/* The handle's edge is the accent at rest, so focus rings it in @text.
   `QSlider:focus::handle` would match an unfocused slider too. */
QSlider[fxFocusVisible="true"]::handle:horizontal:focus,
QSlider[fxFocusVisible="true"]::handle:vertical:focus
{
    border-color: @text;
}

/* A tab's focus recolours the edge it reserves. */
QTabBar[fxFocusVisible="true"]::tab:focus { border-color: @accent_primary; }

/* A checkbox and a radio button have no border of their own to recolour, so
   both states declare one and only the colour differs. The indicator's own
   focus artwork stays as it is; this ring is what carries the label. */
QCheckBox[fxFocusVisible="true"]:focus,
QRadioButton[fxFocusVisible="true"]:focus
{
    border-color: @accent_primary;
}

/* A primary button is filled with the accent, so its ring is the text. */
QPushButton[fxRole="primary"][fxFocusVisible="true"]:focus
{
    border-color: @text;
}

QPushButton[fxRole="flat"][fxFocusVisible="true"]:focus
{
    border-color: @accent_primary;
}
